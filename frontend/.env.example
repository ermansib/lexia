# Gateway that fronts every Lexia service.
VITE_API_BASE_URL=http://localhost:5000
# "dev" signs in as a local author (backend must run with Auth:UseDevelopmentUser=true).
# "oidc" signs in through Keycloak.
VITE_AUTH_MODE=dev
VITE_OIDC_AUTHORITY=http://localhost:8080/realms/lexia
VITE_OIDC_CLIENT_ID=lexia-web
