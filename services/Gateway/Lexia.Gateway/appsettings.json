{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "Origins": [ "http://localhost:5173" ]
  },
  "ReverseProxy": {
    "Routes": {
      "books": {
        "ClusterId": "books",
        "Match": { "Path": "/api/v1/books/{**rest}" }
      },
      "books-root": {
        "ClusterId": "books",
        "Match": { "Path": "/api/v1/books" }
      },
      "studio": {
        "ClusterId": "studio",
        "Match": { "Path": "/api/v1/studio/{**rest}" }
      }
    },
    "Clusters": {
      "books": {
        "Destinations": { "primary": { "Address": "http://localhost:5101" } }
      },
      "studio": {
        "Destinations": { "primary": { "Address": "http://localhost:5102" } }
      }
    }
  }
}
